{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ECommerceApp",
    "Audience": "ECommerceApp.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "SeedAdmin": {
    "Email": "",
    "Password": ""
  },
  "RateLimiting": {
    "AuthPermitLimit": 5,
    "AuthWindowSeconds": 60
  },
  "Store": {
    "Name": "ECommerce Store",
    "Currency": "PKR",
    "DefaultCountry": "Pakistan"
  }
}
