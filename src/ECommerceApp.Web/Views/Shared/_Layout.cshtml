@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var storeName = Configuration["Store:Name"] ?? "ECommerceApp Store";
    var csrfToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="@csrfToken" />
    <title>@ViewData["Title"] - @storeName</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ECommerceApp.Web.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <div class="utility-bar bg-dark text-light small py-1">
            <div class="container d-flex justify-content-between">
                <span>Free shipping on eligible orders</span>
                <span class="text-white-50" aria-disabled="true">Help &middot; Track Order</span>
            </div>
        </div>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">@storeName</a>

                <form class="d-none d-lg-flex flex-grow-1 mx-4 position-relative" role="search" asp-controller="Catalog" asp-action="Search" method="get" autocomplete="off">
                    <input class="form-control" type="search" name="q" id="searchInput" placeholder="Search products" />
                    <div id="searchSuggestions" class="list-group position-absolute w-100 shadow-sm" style="top:100%; z-index:1050; display:none;"></div>
                </form>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavCollapse"
                        aria-controls="mainNavCollapse" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavCollapse">
                    <div class="d-md-none border-top pt-2 mt-2">
                        @await Component.InvokeAsync("CategoryNav")
                    </div>
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item">@await Component.InvokeAsync("WishlistSummary")</li>
                        <li class="nav-item">@await Component.InvokeAsync("CartSummary")</li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Profile">Hi, @User.Identity.Name</a></li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link">Log out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
        <div class="category-nav bg-light border-bottom d-none d-md-block">
            <div class="container">
                @await Component.InvokeAsync("CategoryNav")
            </div>
        </div>
    </header>

    <div class="container flex-grow-1">
        @await Html.PartialAsync("_Breadcrumbs")
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top bg-light text-muted mt-auto">
        <div class="container py-4">
            <div class="row">
                <div class="col-md-4">
                    <h6>@storeName</h6>
                    <p class="small">Original design and storefront &mdash; built with ASP.NET Core.</p>
                </div>
                <div class="col-md-4">
                    <h6>Customer Service</h6>
                    <p class="small text-muted" aria-disabled="true">Help Center &middot; Returns &middot; Shipping</p>
                </div>
                <div class="col-md-4">
                    <h6>Company</h6>
                    <p class="small text-muted" aria-disabled="true">About &middot; Contact &middot; Privacy</p>
                </div>
            </div>
            <div class="small text-center pt-2 border-top">&copy; @DateTime.UtcNow.Year - @storeName</div>
        </div>
    </footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
