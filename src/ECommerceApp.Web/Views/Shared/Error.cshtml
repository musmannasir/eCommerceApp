@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="text-center py-5">
    <h1 class="display-5">Something went wrong</h1>
    <p class="lead text-muted">
        We couldn't complete your request. Please try again, or return to the home page.
    </p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Reference ID: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to home</a>
</div>
