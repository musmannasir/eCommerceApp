@model ECommerceApp.Web.Models.Checkout.CheckoutConfirmationPageViewModel
@{
    ViewData["Title"] = "Checkout - Confirmation";
    var order = Model.Order;
    var paid = order.Status == nameof(ECommerceApp.Domain.Orders.OrderStatus.Paid);
    var stockFailed = order.Status == nameof(ECommerceApp.Domain.Orders.OrderStatus.StockReservationFailed);
}

<h1 class="h3 mb-1">Checkout</h1>

@if (paid)
{
    <div class="alert alert-success">
        <strong>Thank you - your order @order.OrderNumber has been placed and paid.</strong>
        A confirmation email arrives in a later milestone.
    </div>
}
else if (stockFailed)
{
    <div class="alert alert-warning">
        <strong>Your order @order.OrderNumber could not be placed - some items are no longer available.</strong>
        @order.StockIssueMessage
        Your payment method was not charged. To try again, adjust the quantities in your cart
        and check out again.
    </div>
}
else
{
    <div class="alert alert-danger">
        <strong>Your order @order.OrderNumber was placed, but payment failed.</strong>
        @order.DeclineReason
        To try again, go back to your cart and check out with a different card - this order
        will not retry automatically.
    </div>
}

<p class="text-muted small">Placed @order.PlacedAtUtc.ToString("f") UTC</p>

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-body">
                <div class="text-muted small">Shipping to</div>
                <strong>@(string.IsNullOrEmpty(order.ShippingLabel) ? order.ShippingFullName : order.ShippingLabel)</strong>
                <div class="small">@order.ShippingFullName &middot; @order.ShippingPhone</div>
                <div class="small">
                    @order.ShippingLine1, @order.ShippingCity@(!string.IsNullOrEmpty(order.ShippingRegionCode) ? $", {order.ShippingRegionCode}" : "") @order.ShippingPostalCode, @order.ShippingCountryCode
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <div class="text-muted small">Shipping method</div>
                <strong>@order.ShippingMethodName</strong> - @(order.ShippingCost == 0 ? "Free" : order.ShippingCost.ToString("0.00"))
            </div>
        </div>

        @if (!stockFailed)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <div class="text-muted small">Payment</div>
                    <strong>@(paid ? "Paid" : "Declined")</strong>
                    @if (!string.IsNullOrEmpty(order.CardBrand))
                    {
                        <span>- @order.CardBrand @order.MaskedCardNumber</span>
                    }
                </div>
            </div>
        }

        <div class="card">
            <div class="card-body">
                <h2 class="h6">Items</h2>
                <table class="table table-sm align-middle mb-0">
                    <tbody>
                        @foreach (var item in order.Items)
                        {
                            <tr>
                                <td>
                                    @item.ProductName
                                    @if (!string.IsNullOrEmpty(item.VariantDescription))
                                    {
                                        <div class="text-muted small">@item.VariantDescription</div>
                                    }
                                </td>
                                <td class="text-center">&times;@item.Quantity</td>
                                <td class="text-end">@item.LineTotal.ToString("0.00")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h2 class="h6">Order total</h2>
                <div class="d-flex justify-content-between">
                    <span>Subtotal</span>
                    <span>@order.Subtotal.ToString("0.00")</span>
                </div>
                @if (order.PromotionDiscountAmount > 0)
                {
                    <div class="d-flex justify-content-between text-success">
                        <span>
                            Discount
                            @if (!string.IsNullOrEmpty(order.AppliedCouponCode))
                            {
                                <span class="text-muted small">(@order.AppliedCouponCode)</span>
                            }
                        </span>
                        <span>-@order.PromotionDiscountAmount.ToString("0.00")</span>
                    </div>
                }
                <div class="d-flex justify-content-between">
                    <span>Tax</span>
                    <span>@order.Tax.ToString("0.00")</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Shipping</span>
                    <span>@(order.ShippingCost == 0 ? "Free" : order.ShippingCost.ToString("0.00"))</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between fs-5">
                    <strong>Total</strong>
                    <strong>@order.GrandTotal.ToString("0.00")</strong>
                </div>
                <a asp-controller="Orders" asp-action="Details" asp-route-orderNumber="@order.OrderNumber" class="btn btn-outline-primary w-100 mt-3">View order details</a>
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">Continue shopping</a>
            </div>
        </div>
    </div>
</div>
