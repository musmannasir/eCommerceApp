@model ECommerceApp.Web.Models.Checkout.CheckoutAddressPageViewModel
@{
    ViewData["Title"] = "Checkout - Address";
}

<h1 class="h3 mb-1">Checkout</h1>
<p class="text-muted">Step 1 of 3 - Shipping address</p>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="row">
    <div class="col-lg-8">
        <form asp-action="Index" method="post">
            @foreach (var address in Model.Addresses)
            {
                <div class="card mb-2">
                    <div class="card-body">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="addressId" id="address-@address.Id"
                                   value="@address.Id" checked="@(address.Id == Model.SelectedAddressId)" />
                            <label class="form-check-label w-100" for="address-@address.Id">
                                <strong>@(string.IsNullOrEmpty(address.Label) ? address.FullName : address.Label)</strong>
                                @if (address.IsDefault)
                                {
                                    <span class="badge text-bg-primary ms-1">Default</span>
                                }
                                <div class="text-muted small">@address.FullName &middot; @address.Phone</div>
                                <div class="small">
                                    @address.Line1,
                                    @if (!string.IsNullOrEmpty(address.Line2))
                                    {
                                        @:@address.Line2,
                                    }
                                    @address.City@(!string.IsNullOrEmpty(address.RegionCode) ? $", {address.RegionCode}" : "") @address.PostalCode, @address.CountryCode
                                </div>
                            </label>
                        </div>
                    </div>
                </div>
            }

            <div class="d-flex justify-content-between mt-3">
                <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary">Back to cart</a>
                <button type="submit" class="btn btn-primary">Continue to shipping</button>
            </div>
        </form>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h2 class="h6">Order summary</h2>
                <div>@Model.ItemCount item@(Model.ItemCount == 1 ? "" : "s")</div>
                <div>Subtotal: <strong>@Model.Subtotal.ToString("0.00")</strong></div>
                <div class="text-muted small mt-2">Tax and shipping calculated in the next steps.</div>
            </div>
        </div>
    </div>
</div>
