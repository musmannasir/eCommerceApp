@{
    ViewData["Title"] = "Password reset";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 col-lg-5 text-center">
        <h1 class="h3 mb-3">Password reset</h1>
        <p class="text-muted">Your password has been reset. You can now log in with your new password.</p>
        <a class="btn btn-primary" asp-action="Login">Log in</a>
    </div>
</div>
