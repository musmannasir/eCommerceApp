@model LoginViewModel
@{
    ViewData["Title"] = "Log in";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3 mb-3">Log in</h1>
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-info">@message</div>
        }
        <div asp-validation-summary="ModelOnly"></div>
        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>
            <button type="submit" class="btn btn-primary w-100">Log in</button>
        </form>
        <p class="mt-3 small">
            <a asp-action="ForgotPassword">Forgot your password?</a>
        </p>
        <p class="small">Don't have an account? <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Create one</a>.</p>
    </div>
</div>
