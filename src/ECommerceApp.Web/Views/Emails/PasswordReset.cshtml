@model ECommerceApp.Application.Notifications.Models.PasswordResetEmailModel
@{
    Layout = null;
}
<div style="font-family: Arial, Helvetica, sans-serif; max-width: 480px; margin: 0 auto; color: #212529;">
    <h1 style="font-size: 20px;">Reset your password</h1>
    <p>We received a request to reset your password. Click the button below to choose a new one.</p>
    <p style="margin: 24px 0;">
        <a href="@Model.ResetLink" style="background-color: #0d6efd; color: #ffffff; padding: 10px 20px; border-radius: 4px; text-decoration: none; display: inline-block;">Reset password</a>
    </p>
    <p style="color: #6c757d; font-size: 13px;">If the button doesn't work, copy and paste this link into your browser:<br />@Model.ResetLink</p>
    <p style="color: #6c757d; font-size: 13px;">If you didn't request this, you can safely ignore this email.</p>
</div>
