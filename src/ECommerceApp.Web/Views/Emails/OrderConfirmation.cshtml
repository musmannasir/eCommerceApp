@model ECommerceApp.Application.Notifications.Models.OrderConfirmationEmailModel
@{
    Layout = null;
}
<div style="font-family: Arial, Helvetica, sans-serif; max-width: 560px; margin: 0 auto; color: #212529;">
    <h1 style="font-size: 20px;">Thanks for your order, @Model.CustomerName!</h1>
    <p>Your order <strong>@Model.OrderNumber</strong> was placed on @Model.PlacedAtUtc.ToString("f") UTC and has been paid.</p>

    <table style="width: 100%; border-collapse: collapse; margin: 16px 0;">
        <thead>
            <tr>
                <th style="text-align: left; border-bottom: 1px solid #dee2e6; padding: 6px 0;">Item</th>
                <th style="text-align: center; border-bottom: 1px solid #dee2e6; padding: 6px 0;">Qty</th>
                <th style="text-align: right; border-bottom: 1px solid #dee2e6; padding: 6px 0;">Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td style="padding: 6px 0; border-bottom: 1px solid #f1f3f5;">
                        @item.ProductName
                        @if (!string.IsNullOrEmpty(item.VariantDescription))
                        {
                            <div style="color: #6c757d; font-size: 12px;">@item.VariantDescription</div>
                        }
                    </td>
                    <td style="text-align: center; padding: 6px 0; border-bottom: 1px solid #f1f3f5;">@item.Quantity</td>
                    <td style="text-align: right; padding: 6px 0; border-bottom: 1px solid #f1f3f5;">@item.LineTotal.ToString("0.00")</td>
                </tr>
            }
        </tbody>
    </table>

    <table style="width: 100%; border-collapse: collapse;">
        <tr>
            <td style="padding: 2px 0;">Subtotal</td>
            <td style="text-align: right; padding: 2px 0;">@Model.Subtotal.ToString("0.00")</td>
        </tr>
        @if (Model.PromotionDiscountAmount > 0)
        {
            <tr>
                <td style="padding: 2px 0;">Discount</td>
                <td style="text-align: right; padding: 2px 0;">-@Model.PromotionDiscountAmount.ToString("0.00")</td>
            </tr>
        }
        <tr>
            <td style="padding: 2px 0;">Tax</td>
            <td style="text-align: right; padding: 2px 0;">@Model.Tax.ToString("0.00")</td>
        </tr>
        <tr>
            <td style="padding: 2px 0;">Shipping</td>
            <td style="text-align: right; padding: 2px 0;">@(Model.ShippingCost == 0 ? "Free" : Model.ShippingCost.ToString("0.00"))</td>
        </tr>
        <tr>
            <td style="padding: 6px 0 0 0; font-weight: bold; border-top: 1px solid #dee2e6;">Total</td>
            <td style="text-align: right; padding: 6px 0 0 0; font-weight: bold; border-top: 1px solid #dee2e6;">@Model.GrandTotal.ToString("0.00")</td>
        </tr>
    </table>

    <p style="color: #6c757d; font-size: 13px; margin-top: 24px;">You can view the full order details and its status any time from your account's order history.</p>
</div>
