@model IReadOnlyList<BrandDto>
@{
    ViewData["Title"] = "Brands";
}

<h1 class="h3 mb-4">Brands</h1>

@if (Model.Count == 0)
{
    <p class="text-muted">No brands yet.</p>
}
else
{
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
        @foreach (var brand in Model)
        {
            <div class="col">
                <a href="/Brand/@brand.Slug" class="text-decoration-none text-reset">
                    <div class="card h-100 text-center">
                        @if (!string.IsNullOrEmpty(brand.LogoPath))
                        {
                            <img src="@brand.LogoPath" class="card-img-top" alt="@brand.Name" style="height:100px;object-fit:contain" />
                        }
                        <div class="card-body py-2">
                            <div class="fw-semibold">@brand.Name</div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}
