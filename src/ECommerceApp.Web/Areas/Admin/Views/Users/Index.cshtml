@using Microsoft.AspNetCore.Mvc.Rendering
@model PagedResult<UserListItemDto>
@{
    ViewData["Title"] = "Users";
    var search = ViewData["Search"] as string;
    var role = ViewData["Role"] as string;
    var activeOnly = ViewData["ActiveOnly"] as bool?;
    var roles = (List<SelectListItem>)ViewData["Roles"]!;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Users</h1>
    <a asp-action="Create" class="btn btn-primary">New user</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="search" name="search" value="@search" class="form-control" placeholder="Search name or email" />
    </div>
    <div class="col-auto">
        <select name="role" class="form-select">
            <option value="">All roles</option>
            @foreach (var item in roles)
            {
                <option value="@item.Value" selected="@(item.Value == role)">@item.Text</option>
            }
        </select>
    </div>
    <div class="col-auto form-check pt-2">
        <input type="checkbox" name="activeOnly" value="true" class="form-check-input" id="activeOnly" checked="@(activeOnly == true)" />
        <label class="form-check-label" for="activeOnly">Active only</label>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Search</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Last login</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var user in Model.Items)
        {
            <tr>
                <td>@user.FirstName @user.LastName</td>
                <td class="text-muted small">@user.Email</td>
                <td><span class="badge text-bg-info">@user.Role</span></td>
                <td>
                    @if (user.IsActive)
                    {
                        <span class="badge text-bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">Inactive</span>
                    }
                </td>
                <td class="text-muted small">@(user.LastSuccessfulLoginAtUtc?.ToString("g") ?? "Never")</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="6" class="text-center text-muted py-4">No users found.</td></tr>
        }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@search" asp-route-role="@role" asp-route-activeOnly="@activeOnly">@i</a>
                </li>
            }
        </ul>
    </nav>
}
