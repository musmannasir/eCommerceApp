@using Microsoft.AspNetCore.Mvc.Rendering
@model UserEditViewModel
@{
    ViewData["Title"] = "Edit user";
    var roles = (List<SelectListItem>)ViewData["Roles"]!;
}

<h1 class="h3 mb-1">Edit user</h1>
<p class="text-muted small">@Model.Email &middot; Joined @Model.CreatedAtUtc.ToString("d") &middot; Last login @(Model.LastSuccessfulLoginAtUtc?.ToString("g") ?? "Never")</p>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (Model.IsSelf)
{
    <div class="alert alert-info">This is your own account - role changes and deactivation are disabled here to prevent locking yourself out.</div>
}

<form asp-action="Edit" method="post" class="row g-3 mb-4" style="max-width: 560px;">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="IsSelf" />

    <div class="col-md-6">
        <label asp-for="FirstName" class="form-label"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="LastName" class="form-label"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Role" class="form-label"></label>
        <select asp-for="Role" asp-items="roles" class="form-select" disabled="@Model.IsSelf"></select>
        @if (Model.IsSelf)
        {
            <input type="hidden" asp-for="Role" />
        }
        <span asp-validation-for="Role" class="text-danger"></span>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

<div class="d-flex gap-2">
    @if (Model.IsActive)
    {
        <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-outline-warning" disabled="@Model.IsSelf">Deactivate</button>
        </form>
    }
    else
    {
        <form asp-action="Activate" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-outline-success">Activate</button>
        </form>
    }

    @if (Model.IsLockedOut)
    {
        <form asp-action="Unlock" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-outline-secondary">Unlock account</button>
        </form>
    }

    <form asp-action="SendPasswordReset" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-outline-secondary">Send password reset</button>
    </form>
</div>
