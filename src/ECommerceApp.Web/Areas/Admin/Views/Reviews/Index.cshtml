@using ECommerceApp.Application.Common.Models
@using ECommerceApp.Application.Reviews.Models
@model PagedResult<ReviewModerationQueueItemDto>
@{
    ViewData["Title"] = "Review Moderation";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Review Moderation</h1>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (Model.Items.Count == 0)
{
    <p class="text-muted">No reported reviews - the queue is empty.</p>
}
else
{
    @foreach (var item in Model.Items)
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <a asp-area="" asp-controller="Product" asp-action="Details" asp-route-slug="@item.ProductSlug" target="_blank">@item.ProductName</a>
                        <div class="small text-muted">by @item.ReviewerDisplayName &middot; @item.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") &middot; @item.Rating / 5</div>
                    </div>
                    <span class="badge text-bg-danger">@item.ReportCount report@(item.ReportCount == 1 ? "" : "s")</span>
                </div>

                @if (!string.IsNullOrEmpty(item.Title))
                {
                    <div class="fw-semibold">@item.Title</div>
                }
                <p>@item.Body</p>

                <h6 class="small text-uppercase text-muted">Reports</h6>
                <table class="table table-sm">
                    <thead>
                        <tr><th>Reporter</th><th>Reason</th><th>Details</th><th>Reported</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var report in item.Reports)
                        {
                            <tr>
                                <td>@report.ReporterDisplayName</td>
                                <td>@report.Reason</td>
                                <td>@report.Comment</td>
                                <td>@report.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="d-flex gap-2">
                    <form method="post" asp-action="Dismiss" asp-route-reviewId="@item.ReviewId">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Dismiss reports</button>
                    </form>
                    <form method="post" asp-action="Remove" asp-route-reviewId="@item.ReviewId">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove review</button>
                    </form>
                </div>
            </div>
        </div>
    }

    @if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination">
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
