@using ECommerceApp.Domain.Security
@model PagedResult<AuditLogEntryDto>
@{
    ViewData["Title"] = "Audit Log";
    var eventType = ViewData["EventType"] as SecurityEventType?;
    var succeeded = ViewData["Succeeded"] as bool?;
    var search = ViewData["Search"] as string;
    var from = (DateTime)ViewData["From"]!;
    var to = (DateTime)ViewData["To"]!;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Audit Log</h1>
    <a class="btn btn-outline-secondary btn-sm" asp-action="ExportCsv"
       asp-route-eventType="@eventType" asp-route-succeeded="@succeeded" asp-route-search="@search"
       asp-route-from="@from.ToString("yyyy-MM-dd")" asp-route-to="@to.ToString("yyyy-MM-dd")">Export CSV</a>
</div>

<form method="get" class="row g-2 mb-4 align-items-end">
    <div class="col-auto">
        <label class="form-label small" for="from">From</label>
        <input type="date" id="from" name="from" class="form-control" value="@from.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-auto">
        <label class="form-label small" for="to">To</label>
        <input type="date" id="to" name="to" class="form-control" value="@to.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-auto">
        <label class="form-label small" for="eventType">Event</label>
        <select id="eventType" name="eventType" class="form-select">
            <option value="">All events</option>
            @foreach (var value in Enum.GetNames<SecurityEventType>())
            {
                <option value="@value" selected="@(value == eventType?.ToString())">@value</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label small" for="succeeded">Outcome</label>
        <select id="succeeded" name="succeeded" class="form-select">
            <option value="">Any</option>
            <option value="true" selected="@(succeeded == true)">Succeeded</option>
            <option value="false" selected="@(succeeded == false)">Failed</option>
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label small" for="search">User email</label>
        <input type="search" id="search" name="search" class="form-control" value="@search" placeholder="Search by email" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Filter</button>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <p class="text-muted">No matching audit events.</p>
}
else
{
    <table class="table table-sm align-middle">
        <thead>
            <tr><th>Date</th><th>Event</th><th>Outcome</th><th>User</th><th>IP address</th><th>Details</th></tr>
        </thead>
        <tbody>
            @foreach (var entry in Model.Items)
            {
                <tr>
                    <td class="text-nowrap">@entry.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@entry.EventType</td>
                    <td>
                        @if (entry.Succeeded)
                        {
                            <span class="badge text-bg-success">Succeeded</span>
                        }
                        else
                        {
                            <span class="badge text-bg-danger">Failed</span>
                        }
                    </td>
                    <td class="text-muted small">@(entry.UserEmail ?? "-")</td>
                    <td class="text-muted small">@(entry.IpAddress ?? "-")</td>
                    <td class="text-muted small">@entry.Details</td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination">
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i"
                           asp-route-eventType="@eventType" asp-route-succeeded="@succeeded" asp-route-search="@search"
                           asp-route-from="@from.ToString("yyyy-MM-dd")" asp-route-to="@to.ToString("yyyy-MM-dd")">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
