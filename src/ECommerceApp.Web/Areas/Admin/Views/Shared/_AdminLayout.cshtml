@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var storeName = Configuration["Store:Name"] ?? "ECommerceApp Store";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @storeName Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <nav class="navbar navbar-dark bg-dark px-3">
        <a class="navbar-brand" asp-area="Admin" asp-controller="Home" asp-action="Index">@storeName &mdash; Admin</a>
        <span class="navbar-text text-white-50" aria-disabled="true">Signed in</span>
    </nav>
    <div class="d-flex admin-shell">
        <aside class="admin-sidebar bg-light border-end">
            <ul class="nav flex-column py-3">
                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Home" asp-action="Index">Dashboard</a></li>
                <li class="nav-item px-3 pt-2 pb-1 small text-muted text-uppercase">Catalog</li>
                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Categories" asp-action="Index">Categories</a></li>
                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Brands" asp-action="Index">Brands</a></li>
                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Products" asp-action="Index">Products</a></li>
                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="ProductAttributes" asp-action="Index">Attributes</a></li>
                <li class="nav-item px-3 pt-2 pb-1 small text-muted text-uppercase">Inventory</li>
                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Inventory" asp-action="Index">Overview</a></li>
                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Warehouses" asp-action="Index">Warehouses</a></li>
                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Suppliers" asp-action="Index">Suppliers</a></li>
                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="PurchaseOrders" asp-action="Index">Purchase Orders</a></li>
                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Orders" asp-action="Index">Orders</a></li>
                <li class="nav-item"><span class="nav-link disabled" aria-disabled="true">Customers</span></li>
                <li class="nav-item px-3 pt-2 pb-1 small text-muted text-uppercase">Marketing</li>
                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="HomePageBanners" asp-action="Index">Home Page Banners</a></li>
                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Promotions" asp-action="Index">Promotions</a></li>
                <li class="nav-item px-3 pt-2 pb-1 small text-muted text-uppercase">Checkout</li>
                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="TaxRates" asp-action="Index">Tax Rates</a></li>
                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="ShippingMethods" asp-action="Index">Shipping Methods</a></li>
                <li class="nav-item"><span class="nav-link disabled" aria-disabled="true">Reports</span></li>
                <li class="nav-item"><span class="nav-link disabled" aria-disabled="true">Settings</span></li>
            </ul>
        </aside>
        <main class="flex-grow-1 p-4">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
