@using ECommerceApp.Application.Common.Models
@using ECommerceApp.Application.Finance.Models
@model PagedResult<LedgerEntryDto>
@{
    ViewData["Title"] = "Ledger";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Ledger</h1>
    <a class="btn btn-outline-secondary btn-sm" asp-action="ExportCsv">Export CSV</a>
</div>

@if (Model.Items.Count == 0)
{
    <p class="text-muted">No transactions yet.</p>
}
else
{
    <table class="table table-sm align-middle">
        <thead>
            <tr><th>Date</th><th>Type</th><th>Order</th><th class="text-end">Amount</th></tr>
        </thead>
        <tbody>
            @foreach (var entry in Model.Items)
            {
                var isRefund = entry.Type == LedgerEntryType.Refund;
                <tr>
                    <td>@entry.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    <td><span class="badge @(isRefund ? "text-bg-danger" : "text-bg-success")">@entry.Type</span></td>
                    <td>@entry.OrderNumber</td>
                    <td class="text-end @(isRefund ? "text-danger" : "")">@entry.Amount.ToString("0.00")</td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination">
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
