@using ECommerceApp.Application.Finance.Models
@model CashFlowResultDto
@{
    ViewData["Title"] = "Cash Flow";
    var maxValue = Model.Periods.Count == 0 ? 0m : Model.Periods.Max(p => Math.Max(p.Revenue, p.Refunded));
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Cash Flow</h1>
</div>

<form method="get" class="row g-2 mb-4 align-items-end">
    <div class="col-auto">
        <label class="form-label small" for="from">From</label>
        <input type="date" id="from" name="from" class="form-control" value="@Model.From.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-auto">
        <label class="form-label small" for="to">To</label>
        <input type="date" id="to" name="to" class="form-control" value="@Model.To.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Filter</button>
    </div>
    <div class="col-auto">
        <a class="btn btn-outline-secondary" asp-action="CashFlowExportCsv" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")">Export CSV</a>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="card">
            <div class="card-body">
                <div class="text-muted small">Revenue in range</div>
                <div class="fs-4">@Model.TotalRevenue.ToString("0.00")</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card">
            <div class="card-body">
                <div class="text-muted small">Refunded in range</div>
                <div class="fs-4">@Model.TotalRefunded.ToString("0.00")</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card">
            <div class="card-body">
                <div class="text-muted small">Net in range</div>
                <div class="fs-4">@Model.TotalNet.ToString("0.00")</div>
            </div>
        </div>
    </div>
</div>

<table class="table table-sm align-middle">
    <thead>
        <tr><th>Date</th><th>Revenue</th><th>Refunded</th><th class="text-end">Net</th></tr>
    </thead>
    <tbody>
        @foreach (var period in Model.Periods)
        {
            var revenueWidth = maxValue == 0 ? 0 : (double)(period.Revenue / maxValue) * 100;
            var refundedWidth = maxValue == 0 ? 0 : (double)(period.Refunded / maxValue) * 100;
            <tr>
                <td class="text-nowrap">@period.Date.ToString("yyyy-MM-dd")</td>
                <td style="min-width:160px">
                    <div class="d-flex align-items-center gap-2">
                        <div class="bg-success" style="height:0.6rem;width:@(revenueWidth.ToString("0.##"))%;min-width:@(period.Revenue > 0 ? "2px" : "0")"></div>
                        <span class="small">@period.Revenue.ToString("0.00")</span>
                    </div>
                </td>
                <td style="min-width:160px">
                    <div class="d-flex align-items-center gap-2">
                        <div class="bg-danger" style="height:0.6rem;width:@(refundedWidth.ToString("0.##"))%;min-width:@(period.Refunded > 0 ? "2px" : "0")"></div>
                        <span class="small">@period.Refunded.ToString("0.00")</span>
                    </div>
                </td>
                <td class="text-end @(period.Net < 0 ? "text-danger" : "")">@period.Net.ToString("0.00")</td>
            </tr>
        }
    </tbody>
</table>
