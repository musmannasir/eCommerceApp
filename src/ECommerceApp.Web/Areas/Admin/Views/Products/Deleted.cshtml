@model PagedResult<ProductListItemDto>
@{
    ViewData["Title"] = "Deleted products";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Recycle bin - Products</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to products</a>
</div>

<table class="table table-hover align-middle">
    <thead><tr><th>Name</th><th>SKU</th><th></th></tr></thead>
    <tbody>
        @foreach (var product in Model.Items)
        {
            <tr>
                <td>@product.Name</td>
                <td class="text-muted small">@product.BaseSKU</td>
                <td class="text-end">
                    <form asp-action="Restore" asp-route-id="@product.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-success">Restore</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
