@model ProductEditViewModel
@{
    var product = Model.Product;
}

<div class="row">
    @foreach (var image in product.Images.OrderBy(i => i.DisplayOrder))
    {
        <div class="col-md-3 mb-3">
            <div class="card">
                <img src="@image.Path" class="card-img-top" alt="@image.AltText" style="height:140px;object-fit:cover" />
                <div class="card-body p-2">
                    @if (image.IsPrimary)
                    {
                        <span class="badge text-bg-primary">Primary</span>
                    }
                    @if (image.ProductVariantId.HasValue)
                    {
                        <span class="badge text-bg-light border">Variant-specific</span>
                    }
                    <form asp-action="DeleteImage" asp-route-imageId="@image.Id" asp-route-productId="@product.Id" method="post" class="mt-2">
                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
@if (product.Images.Count == 0)
{
    <p class="text-muted">No images yet.</p>
}

<div class="card">
    <div class="card-body">
        <h2 class="h6">Upload image</h2>
        <form asp-action="AddImage" method="post" enctype="multipart/form-data" class="row g-2 align-items-end">
            <input type="hidden" name="productId" value="@product.Id" />
            <div class="col-md-4">
                <label class="form-label">File (JPEG, PNG, or WebP)</label>
                <input type="file" name="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">Variant (optional)</label>
                <select name="productVariantId" class="form-select">
                    <option value="">-- Product-level image --</option>
                    @foreach (var variant in product.Variants)
                    {
                        <option value="@variant.Id">@variant.SKU</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Alt text</label>
                <input type="text" name="altText" class="form-control" maxlength="200" />
            </div>
            <div class="col-md-1 form-check">
                <input type="checkbox" name="isPrimary" value="true" class="form-check-input" />
                <label class="form-check-label">Primary</label>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary">Upload</button>
            </div>
        </form>
    </div>
</div>
