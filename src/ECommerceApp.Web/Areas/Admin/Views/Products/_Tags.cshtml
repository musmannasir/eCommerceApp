@model ProductEditViewModel
@{
    var product = Model.Product;
}

<div class="mb-3">
    @foreach (var tag in product.Tags)
    {
        <span class="badge text-bg-light border me-1 mb-1 d-inline-flex align-items-center">
            @tag.Name
            <form asp-action="RemoveTag" asp-route-productId="@product.Id" asp-route-productTagId="@tag.Id" method="post" class="d-inline ms-1">
                <button type="submit" class="btn btn-sm btn-link text-danger p-0" style="line-height:1">&times;</button>
            </form>
        </span>
    }
    @if (product.Tags.Count == 0)
    {
        <p class="text-muted">No tags yet.</p>
    }
</div>

<form asp-action="AddTag" method="post" class="row g-2">
    <input type="hidden" name="ProductId" value="@product.Id" />
    <div class="col-auto">
        <input type="text" name="TagName" class="form-control" placeholder="e.g. Bestseller" required maxlength="100" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Add tag</button>
    </div>
</form>
