@model ProductEditViewModel
@{
    ViewData["Title"] = "Edit product";
    var product = Model.Product;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Edit product</h1>
    <div class="d-flex gap-2">
        @if (product.IsPublished)
        {
            <span class="badge text-bg-success align-self-center">Published</span>
            <form asp-action="Unpublish" asp-route-id="@product.Id" method="post">
                <button type="submit" class="btn btn-outline-secondary btn-sm">Unpublish</button>
            </form>
        }
        else
        {
            <span class="badge text-bg-secondary align-self-center">Draft</span>
            <form asp-action="Publish" asp-route-id="@product.Id" method="post">
                <button type="submit" class="btn btn-primary btn-sm">Publish</button>
            </form>
        }
    </div>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#details">Details</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#images">Images (@product.Images.Count)</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#variants">Variants (@product.Variants.Count)</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#specifications">Specifications (@product.Specifications.Count)</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tags">Tags (@product.Tags.Count)</a></li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="details">
        <form asp-action="Edit" method="post">
            @await Html.PartialAsync("_Form", Model.Form)
        </form>
    </div>

    <div class="tab-pane fade" id="images">
        @await Html.PartialAsync("_Images", Model)
    </div>

    <div class="tab-pane fade" id="variants">
        @await Html.PartialAsync("_Variants", Model)
    </div>

    <div class="tab-pane fade" id="specifications">
        @await Html.PartialAsync("_Specifications", Model)
    </div>

    <div class="tab-pane fade" id="tags">
        @await Html.PartialAsync("_Tags", Model)
    </div>
</div>
