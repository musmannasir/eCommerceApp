@model ProductEditViewModel
@{
    var product = Model.Product;
}

<table class="table table-sm align-middle">
    <thead><tr><th>Name</th><th>Value</th><th>Order</th><th></th></tr></thead>
    <tbody>
        @foreach (var spec in product.Specifications.OrderBy(s => s.DisplayOrder))
        {
            <tr>
                <td>@spec.Name</td>
                <td>@spec.Value</td>
                <td>@spec.DisplayOrder</td>
                <td class="text-end">
                    <form asp-action="DeleteSpecification" asp-route-specificationId="@spec.Id" asp-route-productId="@product.Id" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
        @if (product.Specifications.Count == 0)
        {
            <tr><td colspan="4" class="text-muted">No specifications yet.</td></tr>
        }
    </tbody>
</table>

<div class="card">
    <div class="card-body">
        <h2 class="h6">Add specification</h2>
        <form asp-action="AddSpecification" method="post" class="row g-2">
            <input type="hidden" name="ProductId" value="@product.Id" />
            <div class="col-md-4">
                <input type="text" name="Name" class="form-control" placeholder="e.g. Screen Size" required maxlength="200" />
            </div>
            <div class="col-md-5">
                <input type="text" name="Value" class="form-control" placeholder="e.g. 6.1 inch" required maxlength="1000" />
            </div>
            <div class="col-md-2">
                <input type="number" name="DisplayOrder" class="form-control" placeholder="Order" />
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary">Add</button>
            </div>
        </form>
    </div>
</div>
