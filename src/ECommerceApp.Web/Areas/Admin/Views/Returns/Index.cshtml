@using ECommerceApp.Application.Common.Models
@using ECommerceApp.Application.Returns.Models
@model PagedResult<ReturnRequestQueueItemDto>
@{
    ViewData["Title"] = "Return Requests";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Return Requests</h1>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (Model.Items.Count == 0)
{
    <p class="text-muted">No pending return requests - the queue is empty.</p>
}
else
{
    @foreach (var item in Model.Items)
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <strong>@item.OrderNumber</strong>
                        <div class="small text-muted">@item.CustomerName &middot; @item.RequestedAtUtc.ToString("yyyy-MM-dd HH:mm")</div>
                    </div>
                    <span class="badge text-bg-secondary">@item.Reason</span>
                </div>

                @if (!string.IsNullOrEmpty(item.Comment))
                {
                    <p class="small">@item.Comment</p>
                }

                <h6 class="small text-uppercase text-muted">Items</h6>
                <table class="table table-sm">
                    <thead>
                        <tr><th>Product</th><th>Quantity</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var line in item.Items)
                        {
                            <tr>
                                <td>@line.ProductName</td>
                                <td>@line.Quantity</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="d-flex gap-2 align-items-start">
                    <form method="post" asp-action="Approve" asp-route-id="@item.Id">
                        <button type="submit" class="btn btn-sm btn-outline-success">Approve</button>
                    </form>
                    <form method="post" asp-action="Reject" asp-route-id="@item.Id" class="d-flex gap-2">
                        <input type="text" name="rejectionReason" class="form-control form-control-sm" placeholder="Rejection reason" required />
                        <button type="submit" class="btn btn-sm btn-outline-danger text-nowrap">Reject</button>
                    </form>
                </div>
            </div>
        </div>
    }

    @if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination">
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
