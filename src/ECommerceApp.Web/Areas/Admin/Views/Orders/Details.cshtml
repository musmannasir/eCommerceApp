@using ECommerceApp.Application.Orders.Models
@model OrderDto
@{
    ViewData["Title"] = $"Order {Model.OrderNumber}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Model.OrderNumber <span class="badge text-bg-secondary">@Model.Status</span></h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (!string.IsNullOrEmpty(Model.StockIssueMessage))
{
    <div class="alert alert-warning">@Model.StockIssueMessage</div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-body">
                <div class="text-muted small">Shipping to</div>
                <strong>@(string.IsNullOrEmpty(Model.ShippingLabel) ? Model.ShippingFullName : Model.ShippingLabel)</strong>
                <div class="small">@Model.ShippingFullName &middot; @Model.ShippingPhone</div>
                <div class="small">
                    @Model.ShippingLine1, @Model.ShippingCity@(!string.IsNullOrEmpty(Model.ShippingRegionCode) ? $", {Model.ShippingRegionCode}" : "") @Model.ShippingPostalCode, @Model.ShippingCountryCode
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <div class="text-muted small">Shipping method</div>
                <strong>@Model.ShippingMethodName</strong> - @(Model.ShippingCost == 0 ? "Free" : Model.ShippingCost.ToString("0.00"))
            </div>
        </div>

        @if (Model.Status != nameof(ECommerceApp.Domain.Orders.OrderStatus.StockReservationFailed))
        {
            <div class="card mb-3">
                <div class="card-body">
                    <div class="text-muted small">Payment</div>
                    <strong>@Model.PaymentStatus</strong>
                    @if (!string.IsNullOrEmpty(Model.CardBrand))
                    {
                        <span>- @Model.CardBrand @Model.MaskedCardNumber</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.DeclineReason))
                    {
                        <div class="small text-danger">@Model.DeclineReason</div>
                    }
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.Carrier))
        {
            <div class="card mb-3">
                <div class="card-body">
                    <div class="text-muted small">Shipment</div>
                    <strong>@Model.Carrier</strong> - @Model.TrackingNumber
                    <div class="small text-muted">Shipped @Model.ShippedAtUtc?.ToString("f") UTC</div>
                    @if (Model.DeliveredAtUtc is not null)
                    {
                        <div class="small text-success">Delivered @Model.DeliveredAtUtc?.ToString("f") UTC</div>
                    }
                </div>
            </div>
        }

        <div class="card mb-3">
            <div class="card-body">
                <h2 class="h6">Items</h2>
                <table class="table table-sm align-middle mb-0">
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    @item.ProductName
                                    @if (!string.IsNullOrEmpty(item.VariantDescription))
                                    {
                                        <div class="text-muted small">@item.VariantDescription</div>
                                    }
                                </td>
                                <td class="text-center">&times;@item.Quantity</td>
                                <td class="text-end">@item.LineTotal.ToString("0.00")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h2 class="h6">Internal notes</h2>
                <p class="text-muted small">Staff-only - never shown to the customer.</p>
                <form asp-action="UpdateNotes" asp-route-id="@Model.Id" method="post">
                    <textarea name="notes" class="form-control mb-2" rows="3" maxlength="2000">@Model.AdminNotes</textarea>
                    <button type="submit" class="btn btn-outline-primary btn-sm">Save notes</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-body">
                <h2 class="h6">Order total</h2>
                <div class="d-flex justify-content-between">
                    <span>Subtotal</span>
                    <span>@Model.Subtotal.ToString("0.00")</span>
                </div>
                @if (Model.PromotionDiscountAmount > 0)
                {
                    <div class="d-flex justify-content-between text-success">
                        <span>
                            Discount
                            @if (!string.IsNullOrEmpty(Model.AppliedCouponCode))
                            {
                                <span class="text-muted small">(@Model.AppliedCouponCode)</span>
                            }
                        </span>
                        <span>-@Model.PromotionDiscountAmount.ToString("0.00")</span>
                    </div>
                }
                <div class="d-flex justify-content-between">
                    <span>Tax</span>
                    <span>@Model.Tax.ToString("0.00")</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Shipping</span>
                    <span>@(Model.ShippingCost == 0 ? "Free" : Model.ShippingCost.ToString("0.00"))</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between fs-5">
                    <strong>Total</strong>
                    <strong>@Model.GrandTotal.ToString("0.00")</strong>
                </div>
                <div class="text-muted small mt-2">Placed @Model.PlacedAtUtc.ToString("f") UTC</div>
            </div>
        </div>

        @if (Model.Status == nameof(ECommerceApp.Domain.Orders.OrderStatus.Paid))
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h2 class="h6">Ship order</h2>
                    <form asp-action="Ship" asp-route-id="@Model.Id" method="post">
                        <div class="mb-2">
                            <label class="form-label small">Carrier</label>
                            <input type="text" name="carrier" class="form-control" required maxlength="100" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">Tracking number</label>
                            <input type="text" name="trackingNumber" class="form-control" required maxlength="100" />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Mark shipped</button>
                    </form>
                </div>
            </div>

            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="mb-3"
                  onsubmit="return confirm('Cancel this order? This releases its reserved stock and does not process a refund.');">
                <button type="submit" class="btn btn-outline-danger w-100">Cancel order</button>
            </form>
        }

        @if (Model.Status == nameof(ECommerceApp.Domain.Orders.OrderStatus.Shipped))
        {
            <form asp-action="MarkDelivered" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-primary w-100">Mark delivered</button>
            </form>
        }
    </div>
</div>
