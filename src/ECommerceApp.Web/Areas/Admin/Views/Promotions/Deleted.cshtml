@using ECommerceApp.Application.Marketing.Models
@model PagedResult<PromotionDto>
@{
    ViewData["Title"] = "Deleted promotions";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Recycle bin - Promotions</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to promotions</a>
</div>

<table class="table table-hover align-middle">
    <thead><tr><th>Name</th><th>Coupon code</th><th></th></tr></thead>
    <tbody>
        @foreach (var promotion in Model.Items)
        {
            <tr>
                <td>@promotion.Name</td>
                <td class="text-muted small">@promotion.CouponCode</td>
                <td class="text-end">
                    <form asp-action="Restore" asp-route-id="@promotion.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-success">Restore</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="3" class="text-center text-muted py-4">Nothing here.</td></tr>
        }
    </tbody>
</table>
