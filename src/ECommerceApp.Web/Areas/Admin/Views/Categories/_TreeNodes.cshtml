@model IReadOnlyList<CategoryTreeNodeDto>

@if (Model.Count > 0)
{
    <ul class="list-unstyled @(ViewData["Depth"] is int d && d > 0 ? "ms-4" : "")">
        @foreach (var node in Model)
        {
            <li class="py-1">
                <a asp-action="Edit" asp-route-id="@node.Id">@node.Name</a>
                @if (!node.IsActive)
                {
                    <span class="badge text-bg-secondary ms-1">Inactive</span>
                }
                @{
                    var childViewData = new ViewDataDictionary(ViewData) { ["Depth"] = (ViewData["Depth"] is int dd ? dd : 0) + 1 };
                }
                @await Html.PartialAsync("_TreeNodes", node.Children, childViewData)
            </li>
        }
    </ul>
}
