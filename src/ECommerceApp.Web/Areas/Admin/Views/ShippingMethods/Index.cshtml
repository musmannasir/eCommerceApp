@model PagedResult<ShippingMethodDto>
@{
    ViewData["Title"] = "Shipping methods";
    var search = ViewData["Search"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Shipping methods</h1>
    <div class="d-flex gap-2">
        <a asp-action="Deleted" class="btn btn-outline-secondary">Recycle bin</a>
        <a asp-action="Create" class="btn btn-primary">New shipping method</a>
    </div>
</div>

<p class="text-muted small">
    The cheapest active method for the store's default jurisdiction
    (<code>Store:DefaultShippingCountryCode</code>/<code>Store:DefaultShippingRegionCode</code>) powers
    the Cart page's "Estimated shipping" line. Real, destination-based shipping calculation and
    method selection against a customer's saved address now happen in the Checkout flow - order
    placement itself arrives in Milestone 9.1.
</p>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="search" name="search" value="@search" class="form-control" placeholder="Search name or country" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Search</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr><th>Name</th><th>Country</th><th>Region</th><th>Rate</th><th>Free over</th><th>Delivery</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var method in Model.Items)
        {
            <tr>
                <td>@method.Name</td>
                <td>@method.CountryCode</td>
                <td>@(method.RegionCode ?? "Whole country")</td>
                <td>@($"{method.BaseRate:0.00} + {method.RatePerKg:0.00}/kg")</td>
                <td>@(method.FreeShippingThreshold.HasValue ? method.FreeShippingThreshold.Value.ToString("0.00") : "-")</td>
                <td class="small text-muted">
                    @if (method.EstimatedDeliveryDaysMin.HasValue || method.EstimatedDeliveryDaysMax.HasValue)
                    {
                        @($"{method.EstimatedDeliveryDaysMin}-{method.EstimatedDeliveryDaysMax} days")
                    }
                    else
                    {
                        @:-
                    }
                </td>
                <td>
                    @if (method.IsActive)
                    {
                        <span class="badge text-bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">Inactive</span>
                    }
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@method.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    @if (method.IsActive)
                    {
                        <form asp-action="Deactivate" asp-route-id="@method.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-warning">Deactivate</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Activate" asp-route-id="@method.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                        </form>
                    }
                    <form asp-action="Delete" asp-route-id="@method.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Delete this shipping method?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="8" class="text-center text-muted py-4">No shipping methods found.</td></tr>
        }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@search">@i</a>
                </li>
            }
        </ul>
    </nav>
}
